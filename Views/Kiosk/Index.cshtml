@model string
@{
    ViewData["Title"] = "Welcome";
    ViewData["KioskSuppressTimeout"] = true;
}

<div class="kiosk-idle-branch">@Model</div>
<p class="kiosk-idle-subtitle">Touch an option below to begin</p>

<div class="kiosk-action-grid">
    <a asp-action="CheckOut" class="btn kiosk-action-tile">
        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
        Check Out
    </a>
    <a asp-action="Account" class="btn kiosk-action-tile">
        <i class="bi bi-person-circle" aria-hidden="true"></i>
        My Account
    </a>
    <a asp-action="Search" class="btn kiosk-action-tile">
        <i class="bi bi-search" aria-hidden="true"></i>
        Search
    </a>
</div>
