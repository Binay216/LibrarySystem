@{
    ViewData["Title"] = "My Account";
    ViewData["KioskShowCancel"] = true;
}

<h1 class="kiosk-prompt">Enter Your Card Number</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="kiosk-alert kiosk-alert-error">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

<form asp-action="Account" method="post">
    <input type="text" id="cardNumber" name="cardNumber" class="kiosk-display-input" readonly inputmode="none" aria-label="Card number" autocomplete="off" />

    <partial name="_KioskKeypad" model="@(new KioskKeypadViewModel { TargetSelector = "#cardNumber", Mode = KioskKeypadMode.Numeric })" />

    <button type="submit" class="btn kiosk-continue-btn">
        Continue <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
    </button>
</form>
