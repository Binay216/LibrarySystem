else
{
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Branch</th><th>Available</th><th>Borrowed</th><th>Damaged</th><th>Destroyed</th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Report.BreakdownByBranch)
                {
                    <tr>
                        <td>@b.BranchName</td>
                        <td>@b.Available</td>
                        <td>@b.Borrowed</td>
                        <td>@b.Damaged</td>
                        <td>@b.Destroyed</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Items Away From Home Branch (@Model.Report.AwayFromHomeCount)</h2>
@if (Model.Report.AwayFromHomeItems.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-inbox" aria-hidden="true"></i>
        <p class="mb-0">No data for this period.</p>
    </div>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Item Name</th><th>Library Code</th><th>Home Branch</th><th>Current Branch</th></tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Report.AwayFromHomeItems)
                {
                    <tr>
                        <td>@i.ItemName</td>
                        <td>@i.LibraryCode</td>
                        <td>@i.HomeBranchName</td>
                        <td>@i.CurrentBranchName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

