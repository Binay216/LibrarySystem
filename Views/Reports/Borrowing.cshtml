@model ReportPageViewModel<BorrowingReportViewModel>
@{
    ViewData["Title"] = "Borrowing Report";
}

<h1>Borrowing Report</h1>

<form asp-action="Borrowing" method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-6 col-md-3">
        <label for="startDate" class="form-label mb-0">From</label>
        <input type="date" id="startDate" name="startDate" class="form-control" value="@Model.Report.Filters.StartDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-3">
        <label for="endDate" class="form-label mb-0">To</label>
        <input type="date" id="endDate" name="endDate" class="form-control" value="@Model.Report.Filters.EndDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-3">
        <label for="branchId" class="form-label mb-0">Branch</label>
        <select name="branchId" id="branchId" class="form-select">
            <option value="">All Branches</option>
            @foreach (var branch in Model.Branches)
            {
                <option value="@branch.Value" selected="@(Model.SelectedBranchId.HasValue && Model.SelectedBranchId.Value.ToString() == branch.Value)">@branch.Text</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Apply</button>
    </div>
</form>

<div class="d-flex gap-2 mb-4">
    <a asp-action="BorrowingCsv"
       asp-route-startDate="@Model.Report.Filters.StartDate.ToString("yyyy-MM-dd")"
       asp-route-endDate="@Model.Report.Filters.EndDate.ToString("yyyy-MM-dd")"
       asp-route-branchId="@Model.SelectedBranchId"
       class="btn btn-outline-secondary"><i class="bi bi-filetype-csv me-1" aria-hidden="true"></i>Download CSV</a>
    <a asp-action="BorrowingPdf"
       asp-route-startDate="@Model.Report.Filters.StartDate.ToString("yyyy-MM-dd")"
       asp-route-endDate="@Model.Report.Filters.EndDate.ToString("yyyy-MM-dd")"
       asp-route-branchId="@Model.SelectedBranchId"
       class="btn btn-outline-secondary"><i class="bi bi-filetype-pdf me-1" aria-hidden="true"></i>Download PDF</a>
</div>

<p class="text-muted">Branch: @Model.Report.Filters.BranchName &middot; Period: @Model.Report.Filters.StartDate.ToString("d") - @Model.Report.Filters.EndDate.ToString("d")</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Total Loans</div>
                <div class="fs-2">@Model.Report.TotalLoans</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small">Active Loans</div>
                <div class="fs-2">@Model.Report.ActiveLoanCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-start border-danger border-4">
            <div class="card-body">
                <div class="text-muted small">Overdue Loans</div>
                <div class="fs-2">@Model.Report.OverdueCount</div>
            </div>
        </div>
    </div>
</div>

<h2 class="h4">Most Borrowed Items</h2>
@if (Model.Report.MostBorrowed.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-inbox" aria-hidden="true"></i>
        <p class="mb-0">No data for this period.</p>
    </div>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Item Name</th><th>Library Code</th><th>Loan Count</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Report.MostBorrowed)
                {
                    <tr>
                        <td>@item.ItemName</td>
                        <td>@item.LibraryCode</td>
                        <td>@item.LoanCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Loans By Branch</h2>
@if (Model.Report.BreakdownByBranch.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-inbox" aria-hidden="true"></i>
        <p class="mb-0">No data for this period.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Branch Name</th><th>Loan Count</th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Report.BreakdownByBranch)
                {
                    <tr>
                        <td>@b.BranchName</td>
                        <td>@b.LoanCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
