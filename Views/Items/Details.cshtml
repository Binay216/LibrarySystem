@model Item
@{
    ViewData["Title"] = "Item Details";
}

<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-2">Library Code</dt>
    <dd class="col-sm-10">@Model.LibraryCode</dd>

    <dt class="col-sm-2">Type</dt>
    <dd class="col-sm-10">
        @switch (Model)
        {
            case Book:
                <span>Book</span>
                break;
            case Music:
                <span>Music</span>
                break;
            case Toy:
                <span>Toy</span>
                break;
        }
    </dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10"><partial name="_StatusBadge" model="@Model.Status" /></dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    @if (Model is Book book)
    {
        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@book.Author</dd>
        <dt class="col-sm-2">Genre</dt>
        <dd class="col-sm-10">@book.Genre</dd>
    }
    else if (Model is Music music)
    {
        <dt class="col-sm-2">Artist</dt>
        <dd class="col-sm-10">@music.Artist</dd>
        <dt class="col-sm-2">Year</dt>
        <dd class="col-sm-10">@music.Year</dd>
    }
    else if (Model is Toy toy)
    {
        <dt class="col-sm-2">Toy Type</dt>
        <dd class="col-sm-10">@toy.ToyType</dd>
        <dt class="col-sm-2">Recommended Age</dt>
        <dd class="col-sm-10">@toy.RecommendedAge+</dd>
    }
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
