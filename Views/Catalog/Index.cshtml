@model CatalogSearchViewModel
@{
    ViewData["Title"] = "Catalog";
}

<h1>Catalog</h1>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-12 col-md-3">
        <label asp-for="SearchTerm" class="form-label visually-hidden"></label>
        <input asp-for="SearchTerm" class="form-control" placeholder="Search by name or description" />
    </div>
    <div class="col-6 col-md-2">
        <label asp-for="ItemType" class="form-label visually-hidden"></label>
        <select asp-for="ItemType" asp-items="Html.GetEnumSelectList<ItemTypeOption>()" class="form-select">
            <option value="">All Types</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="BranchId" class="form-label visually-hidden"></label>
        <select asp-for="BranchId" asp-items="Model.Branches" class="form-select">
            <option value="">All Branches</option>
        </select>
    </div>
    <div class="col-6 col-md-2 d-flex align-items-center">
        <div class="form-check">
            <input asp-for="AvailableOnly" class="form-check-input" />
            <label asp-for="AvailableOnly" class="form-check-label">Available only</label>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button>
    </div>
</form>

<p class="text-muted">@Model.Results.Count item(s) found.</p>

@if (Model.Results.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-search" aria-hidden="true"></i>
        <p class="mb-0">No items match your search.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        @foreach (var item in Model.Results)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <partial name="_TypeBadge" model="@item.TypeLabel" />
                            <partial name="_StatusBadge" model="@item.Status" />
                        </div>
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted small">@item.Summary</p>
                        <p class="card-text">@item.Description</p>
                    </div>
                    <div class="card-footer text-muted small">
                        @item.LibraryCode
                        <span class="float-end"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@item.CurrentBranchName</span>
                    </div>
                </div>
            </div>
        }
    </div>
}
