@{
    ViewData["Title"] = "Import Items";
}

<h1>Import Items</h1>
<p class="text-muted">Upload a CSV to bulk-create items. Nothing is saved until you review the parsed rows and confirm.</p>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="card mb-4" style="max-width: 640px;">
    <div class="card-body">
        <form asp-action="Preview" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="file" class="form-label">CSV file</label>
                <input type="file" id="file" name="file" accept=".csv" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1" aria-hidden="true"></i>Upload &amp; Preview</button>
        </form>
    </div>
</div>

<p>
    <a href="~/samples/item-import-sample.csv" download class="btn btn-outline-secondary">
        <i class="bi bi-filetype-csv me-1" aria-hidden="true"></i>Download Sample CSV
    </a>
</p>

<div class="card" style="max-width: 640px;">
    <div class="card-body">
        <h2 class="h5">Columns</h2>
        <p class="mb-2"><code>Type, Name, Description, LibraryCode, HomeBranchCode</code>, plus whichever of these match the row's Type:</p>
        <ul class="mb-0">
            <li><strong>Book</strong>: Author, Genre</li>
            <li><strong>Music</strong>: Artist, Year</li>
            <li><strong>Toy</strong>: ToyType, RecommendedAge</li>
        </ul>
    </div>
</div>
