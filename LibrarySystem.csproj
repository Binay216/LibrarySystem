<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-LibrarySystem-d5fe98e1-9bd8-40db-9548-37e3d4a09f38</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment on a public member) is suppressed project-wide:
         XML docs are written deliberately for the api/v1 controllers/actions, for
         Swagger to surface, not retrofitted across the whole MVC codebase. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundled so MockMetadataProvider works with no internet access and
         regardless of working directory/publish layout - baked into the
         assembly rather than read as a loose file from disk. -->
    <EmbeddedResource Include="Data\Metadata\metadata-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <!-- Not used directly - pulled in transitively by Microsoft.EntityFrameworkCore.SqlServer
         (via Microsoft.Data.SqlClient) at 9.0.11, which has moderate (NU1902) and high
         (NU1903) severity CVEs. Pinned here to the patched 10.0.13 release so NuGet's
         nearest-wins resolution picks it instead of the vulnerable transitive version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
